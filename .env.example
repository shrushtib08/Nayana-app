# ============================================
# NAYANA — Environment Configuration Template
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ============================================

# ---------- Django core ----------
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Database ----------
# Leave blank / omit to fall back to local SQLite (backend/db.sqlite3)
DATABASE_URL=postgres://nayana:nayana@localhost:5432/nayana

# ---------- AI provider (vision + reasoning) ----------
# Supported: "anthropic" | "openai" | "demo"
AI_PROVIDER=demo
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------- OCR provider ----------
# Supported: "google_vision" | "tesseract" | "demo"
OCR_PROVIDER=demo
GOOGLE_VISION_API_KEY=

# ---------- Translation provider ----------
# Supported: "google_translate" | "ai" | "demo"
TRANSLATION_PROVIDER=demo
GOOGLE_TRANSLATE_API_KEY=

# ---------- Text-to-Speech ----------
# The frontend uses the browser's built-in Web Speech API by default,
# so no key is required for the default configuration.
TTS_PROVIDER=web_speech

# ---------- File uploads ----------
MAX_UPLOAD_SIZE_MB=10

# ---------- Frontend (Vite) ----------
VITE_API_BASE_URL=http://localhost:8000/api
VITE_DEMO_MODE=true
